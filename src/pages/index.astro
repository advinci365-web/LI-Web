---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TrustBadges from "../components/TrustBadges.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { services, site } from "../lib/site";
import { unsplash, photos } from "../lib/img";

const stats = [
  { value: "500+", label: "Projects Completed" },
  { value: "10+", label: "Years of Experience" },
  { value: "99%", label: "Happy Customers" },
];

const offers = [
  {
    title: "Free In-Home Measure",
    description: "A consultant visits your home, measures every window and talks through options.",
    icon: "ruler",
  },
  {
    title: "Custom Manufacturing",
    description: "Every blind, curtain and shutter is made to measure for a precise, tailored fit.",
    icon: "scissors",
  },
  {
    title: "Expert Installation",
    description: "Our own trained installers fit your products cleanly, safely and on schedule.",
    icon: "hammer",
  },
  {
    title: "Warranty & Support",
    description: "Manufacturer's warranty plus our workmanship guarantee on every job.",
    icon: "shield-check",
  },
];

const testimonials = [
  {
    quote:
      "The team measured, quoted and installed our plantation shutters within two weeks. The finish is flawless and our living room feels completely transformed.",
    name: "Sarah M.",
    suburb: "Parramatta, NSW",
  },
  {
    quote:
      "Lumora fitted new hybrid flooring through our whole downstairs. Professional from the first phone call to the final clean-up.",
    name: "David K.",
    suburb: "Castle Hill, NSW",
  },
  {
    quote:
      "Beautiful custom curtains at a fair price. The consultant brought so many fabric samples and helped us pick exactly the right look.",
    name: "Priya R.",
    suburb: "Baulkham Hills, NSW",
  },
];

const galleryPreview = [
  { src: photos.curtainsLiving, label: "Curtains" },
  { src: photos.shuttersBathroom, label: "Shutters" },
  { src: photos.heroBlindsCloseup, label: "Blinds" },
  { src: photos.flooringHallway, label: "Flooring" },
];
---

<BaseLayout
  title="Home"
  description="Premium blinds, curtains, shutters and flooring for Sydney homes. Free measure & quote, expert installation and warranty included."
>
  <!-- Hero -->
  <section
    class="relative flex min-h-[560px] items-center overflow-hidden bg-forest-900 sm:min-h-[620px] lg:min-h-[720px]"
  >
    <img
      src={unsplash(photos.heroLiving, 1920, 80)}
      alt="Elegant living room with floor-to-ceiling windows, layered curtains and roller blinds"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-forest-900/80 lg:hidden" aria-hidden="true" />
    <div
      class="absolute inset-0 hidden bg-gradient-to-r from-forest-900 from-5% via-forest-900/80 via-45% to-forest-900/10 lg:block"
      aria-hidden="true"
    />

    <div class="container-lumora relative z-10 py-16">
      <div class="max-w-xl">
        <p class="eyebrow text-gold-300">
          <span class="h-px w-6 bg-current opacity-70" aria-hidden="true" />
          Blinds &middot; Curtains &middot; Shutters &middot; Flooring
        </p>
        <h1 class="mt-4 text-4xl leading-[1.1] text-white sm:text-5xl lg:text-6xl">
          Beautiful Spaces.<br />
          <span class="text-gold-400">Inspired Living.</span>
        </h1>
        <p class="mt-6 max-w-md text-base leading-relaxed text-forest-100/90 sm:text-lg">
          Premium window furnishings and flooring solutions for every home, measured, made and
          installed by Sydney's own Lumora Interiors team.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href="/contact/" class="btn-primary">
            Get Your Free Quote
            <Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
          </a>
          <a href={site.phoneHref} class="btn-outline">
            <Icon name="ph:phone" class="size-4" aria-hidden="true" />
            {site.phone}
          </a>
        </div>
        <dl class="mt-12 grid max-w-md grid-cols-3 gap-4 border-t border-white/20 pt-8">
          {
            stats.map((stat) => (
              <div>
                <dt class="sr-only">{stat.label}</dt>
                <dd class="font-display text-2xl text-white sm:text-3xl">{stat.value}</dd>
                <p class="mt-1 text-xs uppercase tracking-wide text-forest-200">{stat.label}</p>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Services strip -->
  <div class="bg-forest-800">
    <div class="container-lumora grid grid-cols-2 gap-8 py-10 sm:grid-cols-4 sm:gap-6">
      {
        services.map((service) => (
          <a
            href={`/services/#${service.slug}`}
            class="group flex flex-col items-center gap-3 text-center"
            data-reveal
          >
            <span
              class="flex size-14 items-center justify-center rounded-full bg-forest-700 text-gold-400 transition-all duration-300 group-hover:scale-110 group-hover:bg-gold-500 group-hover:text-forest-900"
              data-pop
            >
              <Icon name={`ph:${service.icon}`} class="size-6" aria-hidden="true" />
            </span>
            <span class="font-display text-sm tracking-wide text-white">{service.name}</span>
            <span class="hidden text-xs leading-snug text-forest-200 sm:block">{service.short}</span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- About / expertise -->
  <section class="section-pad">
    <div class="container-lumora grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="relative" data-reveal>
        <div class="aspect-4/5 overflow-hidden rounded-[2rem]">
          <img
            src={unsplash(photos.aboutInterior, 900)}
            alt="Bright home interior styled with custom soft furnishings"
            class="h-full w-full object-cover"
            loading="lazy"
            width="900"
            height="1125"
          />
        </div>
        <div class="absolute -bottom-8 -right-6 w-52 rounded-2xl border-4 border-cream bg-white p-4 shadow-card sm:w-60">
          <img
            src={unsplash(photos.aboutInstall, 400)}
            alt="Installer fitting plantation shutters"
            class="h-28 w-full rounded-lg object-cover"
            loading="lazy"
            width="400"
            height="220"
          />
          <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-forest-700">
            Installed by our own expert team
          </p>
        </div>
      </div>

      <div data-reveal>
        <SectionHeading eyebrow="About Lumora Interiors" title="We bring craft and care to every window, floor and finish." />
        <p class="mt-6 max-w-xl text-ink/70 leading-relaxed">
          From a single room refresh to a full home renovation, our consultants guide you from first
          measure to final install &mdash; matching fabrics, finishes and flooring to the way you
          actually live.
        </p>
        <ul class="mt-8 space-y-4">
          {
            [
              "Obligation-free in-home measure & quote",
              "Custom made-to-measure manufacturing",
              "Own trained installation team",
              "Manufacturer's warranty on every product",
            ].map((point) => (
              <li class="flex items-start gap-3 text-ink/80">
                <Icon name="ph:check-circle" class="mt-0.5 size-5 shrink-0 text-gold-600" aria-hidden="true" />
                {point}
              </li>
            ))
          }
        </ul>
        <a href="/services/" class="btn-forest mt-10">
          Explore Our Services
          <Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- What we offer -->
  <section class="bg-forest-800 section-pad">
    <div class="container-lumora grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <SectionHeading
          eyebrow="What We Offer"
          title="Let your home breathe with light, warmth and texture."
          tone="light"
        />
        <p class="mt-6 max-w-xl text-forest-200 leading-relaxed">
          Every project follows the same considered process, whichever product you choose &mdash;
          honest advice, premium materials and installation you can rely on.
        </p>

        <div class="mt-10 grid gap-6 sm:grid-cols-2">
          {
            offers.map((offer) => (
              <div class="rounded-2xl border border-forest-600 bg-forest-700/60 p-6" data-reveal>
                <span
                  class="flex size-11 items-center justify-center rounded-full bg-gold-500 text-forest-900 transition-transform duration-300 hover:scale-110"
                  data-pop
                >
                  <Icon name={`ph:${offer.icon}`} class="size-5" aria-hidden="true" />
                </span>
                <h3 class="mt-4 font-display text-base text-white">{offer.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-forest-200">{offer.description}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="relative hidden lg:block" data-reveal>
        <div class="aspect-3/4 overflow-hidden rounded-[2rem]">
          <img
            src={unsplash(photos.offerLiving, 900)}
            alt="Living room styled with layered curtains and warm timber flooring"
            class="h-full w-full object-cover"
            loading="lazy"
            width="900"
            height="1200"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="section-pad">
    <div class="container-lumora">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading eyebrow="Our Work" title="A glimpse into recently completed projects." />
        <a href="/gallery/" class="btn-forest shrink-0">
          View Full Gallery
          <Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
        {
          galleryPreview.map((item) => (
            <a
              href="/gallery/"
              class="group relative aspect-square overflow-hidden rounded-2xl"
              data-reveal
            >
              <img
                src={unsplash(item.src, 600)}
                alt={`${item.label} project by Lumora Interiors`}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                width="600"
                height="600"
              />
              <span class="absolute inset-x-3 bottom-3 rounded-full bg-forest-900/80 px-3 py-1.5 text-center text-xs font-semibold uppercase tracking-wide text-white">
                {item.label}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Trust badges -->
  <section class="section-pad bg-forest-50/60">
    <div class="container-lumora">
      <SectionHeading align="center" title="Why homeowners choose Lumora Interiors" class="mx-auto max-w-2xl" />
      <div class="mt-14">
        <TrustBadges />
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section-pad">
    <div class="container-lumora">
      <SectionHeading align="center" eyebrow="Testimonials" title="Trusted by homeowners across Sydney" class="mx-auto max-w-2xl" />
      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {
          testimonials.map((t) => (
            <figure class="flex flex-col rounded-2xl bg-white p-8 shadow-card" data-reveal>
              <Icon name="ph:quotes" class="size-8 text-gold-400" aria-hidden="true" />
              <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-ink/80">
                “{t.quote}”
              </blockquote>
              <figcaption class="mt-6 border-t border-forest-100 pt-4">
                <p class="font-display text-sm text-forest-800">{t.name}</p>
                <p class="text-xs text-ink/50">{t.suburb}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
