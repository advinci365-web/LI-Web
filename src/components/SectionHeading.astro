---
interface Props {
  eyebrow?: string;
  title: string;
  align?: "left" | "center";
  tone?: "dark" | "light";
  size?: "sm" | "lg";
  class?: string;
}

const { eyebrow, title, align = "left", tone = "dark", size = "lg", class: className = "" } = Astro.props;
---

<div class:list={[align === "center" ? "text-center" : "text-left", className]}>
  {
    eyebrow && (
      <p class:list={["eyebrow", tone === "light" && "text-gold-300"]}>
        {eyebrow}
      </p>
    )
  }
  <h2
    class:list={[
      "mt-3 leading-tight",
      size === "lg" ? "text-3xl sm:text-4xl lg:text-[2.75rem]" : "text-xl sm:text-2xl",
      tone === "dark" ? "text-forest-800" : "text-white",
    ]}
  >
    {title}
  </h2>
</div>
