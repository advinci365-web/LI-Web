---
import { Icon } from "astro-icon/components";
import { site, nav, services } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="bg-forest-800 text-forest-100">
  <div class="container-lumora grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
    <div>
      <a href="/" class="flex items-center gap-3">
        <img src="/images/logo/circle-logo.svg" alt="" aria-hidden="true" class="h-11 w-11" />
        <img
          src="/images/logo/logotype-light.svg"
          alt="Lumora Interiors"
          class="h-9 w-auto"
        />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-forest-200">
        Premium window furnishings and flooring solutions for every home &mdash; beautiful spaces, inspired living.
      </p>
      <div class="mt-5 flex items-center gap-3">
        <a
          href={site.social.facebook}
          aria-label="Lumora Interiors on Facebook"
          class="flex size-10 items-center justify-center rounded-full border border-forest-600 text-forest-100 transition-all duration-300 hover:scale-110 hover:border-gold-400 hover:text-gold-400"
        >
          <Icon name="ph:facebook-logo" class="size-5" aria-hidden="true" />
        </a>
        <a
          href={site.social.tiktok}
          aria-label="Lumora Interiors on TikTok"
          class="flex size-10 items-center justify-center rounded-full border border-forest-600 text-forest-100 transition-all duration-300 hover:scale-110 hover:border-gold-400 hover:text-gold-400"
        >
          <Icon name="ph:tiktok-logo" class="size-5" aria-hidden="true" />
        </a>
        <a
          href={site.social.mail}
          aria-label="Email Lumora Interiors"
          class="flex size-10 items-center justify-center rounded-full border border-forest-600 text-forest-100 transition-all duration-300 hover:scale-110 hover:border-gold-400 hover:text-gold-400"
        >
          <Icon name="ph:envelope" class="size-5" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div>
      <h2 class="font-display text-sm uppercase tracking-[0.2em] text-gold-400">Explore</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-forest-200 transition-colors hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-sm uppercase tracking-[0.2em] text-gold-400">Services</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {
          services.map((service) => (
            <li>
              <a href={`/services/#${service.slug}`} class="text-forest-200 transition-colors hover:text-white">
                {service.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="font-display text-sm uppercase tracking-[0.2em] text-gold-400">Contact</h2>
      <ul class="mt-4 space-y-3 text-sm text-forest-200">
        <li class="flex items-start gap-2">
          <Icon name="ph:phone" class="mt-0.5 size-4 shrink-0 text-gold-400" aria-hidden="true" />
          <a href={site.phoneHref} class="hover:text-white">{site.phone}</a>
        </li>
        <li class="flex items-start gap-2">
          <Icon name="ph:envelope" class="mt-0.5 size-4 shrink-0 text-gold-400" aria-hidden="true" />
          <a href={site.emailHref} class="hover:text-white break-all">{site.email}</a>
        </li>
        <li class="flex items-start gap-2">
          <Icon name="ph:map-pin" class="mt-0.5 size-4 shrink-0 text-gold-400" aria-hidden="true" />
          <span>{site.serviceArea}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-forest-700">
    <div class="container-lumora flex flex-col items-center justify-between gap-3 py-6 text-xs text-forest-300 sm:flex-row">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>ABN available on request &middot; Sydney, NSW</p>
    </div>
  </div>
</footer>
