---
import { Icon } from "astro-icon/components";
import { trustBadges } from "../lib/site";
---

<ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
  {
    trustBadges.map((badge) => (
      <li class="flex flex-col items-center text-center" data-reveal>
        <span
          class="flex size-16 items-center justify-center rounded-full border-2 border-gold-300 text-gold-600 transition-transform duration-300 hover:scale-110 hover:rotate-6"
          data-pop
        >
          <Icon name={`ph:${badge.icon}`} class="size-7" aria-hidden="true" />
        </span>
        <span class="mt-3 text-xs font-semibold uppercase tracking-wide text-forest-100">
          {badge.title}
        </span>
      </li>
    ))
  }
</ul>
